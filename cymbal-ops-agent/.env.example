# ---------------------------------------------------------------------------
# Local development configuration template.
#
# Copy this file to `.env` and populate the values below. For deployed
# environments these are injected via Terraform / Cloud Run / the deploy command.
#
#   cp .env.example .env
#
# NOTE: `.env` is git-ignored. Never commit real project IDs, service account
# principals, or Cloud Run endpoints to source control.
# ---------------------------------------------------------------------------

# --- Vertex AI / Gemini configuration --------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# Gemini model backing the coordinator agent.
AGENT_MODEL=gemini-3.6-flash

# --- Core GCP project configuration ----------------------------------------
# Consumed by app/config.py. Falls back to GOOGLE_CLOUD_PROJECT when unset.
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# --- BigQuery Conversational Data Agent (cymbal_analytics_tool) ------------
# The published BQ Conversational Analytics (CA) Data Agent resource.
DATA_AGENT_ID=agent_00000000-0000-0000-0000-000000000000
DATA_AGENT_LOCATION=global
# Optional: provide the fully-qualified resource name to override composition
# from PROJECT_ID / DATA_AGENT_LOCATION / DATA_AGENT_ID.
# DATA_AGENT_NAME=projects/your-gcp-project-id/locations/global/dataAgents/agent_xxx

# --- BigQuery RAG corpus (pos_troubleshooting_rag_tool) --------------------
BQ_DATASET=cymbal_gold
POS_CHUNK_EMBEDDINGS_TABLE=pos_manual_chunk_embeddings
POS_BASELINE_EMBEDDINGS_TABLE=pos_manual_embeddings
EMBEDDING_ENDPOINT=text-embedding-005
# Hybrid relevance floor. Below this the tool returns the mandatory decline message.
SIMILARITY_THRESHOLD=0.70

# --- Cloud Bigtable MCP microservice (bigtable_mcp_toolset) ----------------
# Cloud Run URL of the GCP Database Toolbox MCP microservice.
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-000000000000.us-central1.run.app
# OIDC target audience. Defaults to BIGTABLE_MCP_URL when unset.
# BIGTABLE_MCP_AUDIENCE=https://mcp-toolbox-bigtable-000000000000.us-central1.run.app
# Service account principal impersonated to mint the Cloud Run OIDC ID token.
BIGTABLE_MCP_SERVICE_ACCOUNT=your-sa@your-gcp-project-id.iam.gserviceaccount.com

# --- Server / A2A ----------------------------------------------------------
# APP_URL=http://0.0.0.0:8000
# AGENT_VERSION=0.1.0
# ALLOW_ORIGINS=http://localhost:3000
